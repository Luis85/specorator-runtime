---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The execution layer for the Specorator ecosystem.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --color-bg: #0d1117;
        --color-surface: #161b22;
        --color-border: #21262d;
        --color-text: #e6edf3;
        --color-muted: #8b949e;
        --color-accent: #58a6ff;
        --color-accent-dim: #1f4580;
        --color-green: #3fb950;
        --color-yellow: #d29922;
        --color-orange: #db6d28;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
        --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        --radius: 6px;
        --max-width: 860px;
      }

      html { font-family: var(--font-sans); background: var(--color-bg); color: var(--color-text); line-height: 1.6; }

      body { min-height: 100vh; display: flex; flex-direction: column; }

      a { color: var(--color-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      nav {
        border-bottom: 1px solid var(--color-border);
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      nav .logo {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--color-text);
        letter-spacing: -0.02em;
      }

      nav .logo span { color: var(--color-accent); }

      nav .nav-links { display: flex; gap: 1.25rem; font-size: 0.875rem; }
      nav .nav-links a { color: var(--color-muted); }
      nav .nav-links a:hover { color: var(--color-text); text-decoration: none; }

      nav .badge {
        margin-left: auto;
        background: var(--color-accent-dim);
        color: var(--color-accent);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.6rem;
        border-radius: 2rem;
        letter-spacing: 0.02em;
      }

      main { flex: 1; width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }

      footer {
        border-top: 1px solid var(--color-border);
        padding: 1.5rem;
        text-align: center;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      footer a { color: var(--color-muted); }
      footer a:hover { color: var(--color-text); text-decoration: underline; }
    </style>
  </head>
  <body>
    <nav>
      <span class="logo">specorator<span>-runtime</span></span>
      <div class="nav-links">
        <a href={base}>Product</a>
        <a href={`${base}/demo`}>Demo</a>
        <a href="https://github.com/Luis85/specorator-runtime" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
      <span class="badge">Phase 1</span>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <p>MIT License &middot; <a href="https://github.com/Luis85/specorator-runtime" target="_blank" rel="noopener">github.com/Luis85/specorator-runtime</a></p>
    </footer>
  </body>
</html>
